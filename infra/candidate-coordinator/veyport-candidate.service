[Unit]
Description=Qualify exact private Veyport candidate artifacts
Requires=docker.service veyport-candidate-firewall.service
After=docker.service veyport-candidate-firewall.service network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
LimitCORE=0
RuntimeDirectory=veyport-candidate
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 /opt/veyport-candidate/firewall.py verify
ExecStart=/usr/bin/python3 /opt/veyport-candidate/coordinator.py poll --config /etc/veyport-candidate/coordinator.json
TimeoutStartSec=30min
MemoryMax=1G
MemorySwapMax=0
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/veyport-candidate /run/veyport-candidate /run/docker.sock
