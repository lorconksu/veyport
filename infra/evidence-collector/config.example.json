{
  "repository": "lorconksu/veyport",
  "archive_root": "/var/lib/veyport-evidence/archive",
  "mount_source": "nas.example.invalid:/private/veyport",
  "archive_id": "REPLACE-WITH-OPERATOR-ARCHIVE-UUID",
  "allowed_workflows": [
    ".github/workflows/ci.yml",
    ".github/workflows/release.yml",
    ".github/workflows/delivery.yml",
    ".github/workflows/risk-approval.yml",
    ".github/workflows/staging.yml"
  ],
  "allowed_branches": [
    "main"
  ],
  "allowed_tag_patterns": [
    "v[0-9]+\\.[0-9]+\\.[0-9]+"
  ],
  "allowed_events": [
    "push",
    "workflow_dispatch",
    "workflow_run",
    "release"
  ],
  "reconcile_days": 7,
  "recipient_file": "/etc/veyport-evidence/recipients.txt",
  "identity_file": "/etc/veyport-evidence/identity.txt",
  "signing_key_file": "/etc/veyport-evidence/receipt-key.pem",
  "signing_public_key_file": "/etc/veyport-evidence/receipt-public.pem",
  "read_token_file": "/etc/veyport-evidence/collector-token",
  "delete_token_file": "/etc/veyport-evidence/cleanup-token",
  "retention_enabled": false,
  "trusted_branch": "main",
  "approved_source_revisions": [],
  "trusted_helper_paths": [
    ".github/workflows/delivery.yml",
    ".github/workflows/release.yml",
    ".github/workflows/staging.yml",
    ".github/workflows/risk-approval.yml",
    "scripts/release/candidate.py",
    "scripts/release/release_policy.py",
    "scripts/release/risk_acceptance.py",
    "scripts/release/evidence_manifest.py",
    "scripts/release/evaluate_candidate.sh",
    "scripts/release/authorize_publication.sh",
    "scripts/release/qualify_sca.sh",
    "scripts/release/source_sast.py",
    "scripts/release/public_summary.py",
    "scripts/release/publish_delivery.sh",
    "scripts/release/scan_delivery.sh",
    "scripts/release/check_scan.py",
    "scripts/release/oci_binding.py",
    "scripts/release/artifacts.py",
    "scripts/security/snyk.py",
    "infra/evidence-collector/evidence.py",
    ".github/workflows/ci.yml",
    "scripts/release/ci_evidence.py",
    "scripts/release/capture_step.py",
    "scripts/release/sonar_job_evidence.py",
    "scripts/release/publication.py"
  ],
  "allowed_job_chunks": [
    "unit",
    "server-0",
    "server-1",
    "server-2",
    "server-3",
    "server-4",
    "server-5",
    "test",
    "integration",
    "smoke",
    "e2e",
    "sonar",
    "sast",
    "secrets",
    "vulnerability"
  ],
  "transport_spool": "/var/lib/veyport-evidence/spool",
  "api_calls_per_poll": 60,
  "historical_audit_per_poll": 5,
  "required_complete_jobs": {
    ".github/workflows/release.yml": [
      "unit",
      "server-0",
      "server-1",
      "server-2",
      "server-3",
      "server-4",
      "server-5",
      "test",
      "integration",
      "smoke",
      "e2e",
      "sonar",
      "secrets",
      "vulnerability"
    ],
    ".github/workflows/staging.yml": [
      "unit",
      "server-0",
      "server-1",
      "server-2",
      "server-3",
      "server-4",
      "server-5",
      "test",
      "integration",
      "smoke",
      "e2e",
      "sonar",
      "secrets",
      "vulnerability"
    ]
  },
  "collect_terminal_logs": true,
  "audited_release_publications": []
}
